{
  "name": "ai-mock-interview",
  "version": "0.2.0",
  "private": true,
  "description": "技术岗 AI 模拟面试：按简历出题、层层追问、四维评分、复盘报告。支持任意 OpenAI 兼容模型。",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval-judge.mjs",
    "check-packs": "node scripts/check-packs.cjs",
    "sandbox-image": "node scripts/sandbox-image.cjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "interview",
    "mock-interview",
    "llm",
    "ai",
    "deepseek",
    "openai-compatible",
    "react",
    "vite"
  ],
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
