# 复制为 .env 后填写。不填 LLM_API_KEY 则以 mock 模式运行。
# 任意 OpenAI 兼容接口均可，例如：
#   DeepSeek   https://api.deepseek.com/v1                         deepseek-chat
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi       https://api.moonshot.cn/v1                          moonshot-v1-8k
#   自建网关    http://localhost:8080/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 出题、评分、复盘用的模型（要求推理强）
LLM_MODEL=deepseek-chat
# 面试官说话用的模型（要求快），不填则同 LLM_MODEL
LLM_FAST_MODEL=
# 模型支持 response_format=json_object 时设为 1，JSON 输出更稳
LLM_JSON_MODE=0
PORT=3000

# 算法题的自定义运行和预置用例判题共用这个开关，都不是容器沙箱。
# local（默认，只接受本机请求）/ on（任何来源，公网部署不要用）/ off（关闭）
# 前面有 nginx 等反向代理时请设为 off
# CODE_RUNNER=local
